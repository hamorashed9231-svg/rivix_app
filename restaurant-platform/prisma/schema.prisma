// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  restaurant_owner
  admin
  rider
  control
  supermarket_control
  supervisor
  restaurant_admin
}


enum AccountStatus {
  approved
  pending
  rejected
}

enum RestaurantStatus {
  pending
  active
  suspended
}

enum OrderStatus {
  pending
  accepted
  preparing
  ready
  out_for_delivery
  delivered
  cancelled
}

enum DiscountType {
  percentage
  fixed
}

enum StaffRole {
  manager
  staff
}

enum PaymentType {
  vodafone_cash
  instapay
}

enum PaymentMethod {
  cash_on_delivery
  vodafone_cash
  instapay
}

enum PaymentStatus {
  not_required
  pending_verification
  verified
  rejected
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  phone         String?
  password      String
  role          Role          @default(customer)
  accountStatus AccountStatus @default(approved)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  addresses        Address[]
  restaurants      Restaurant[]      @relation("OwnerRestaurants")
  orders           Order[]           @relation("CustomerOrders")
  reviews          Review[]          @relation("CustomerReviews")
  staffMemberships RestaurantStaff[]
  driverProfile    DriverProfile?
  riderOrders      Order[]           @relation("RiderOrders")
  customerMessages CustomerMessage[] @relation("CustomerMessages")
}

model Address {
  id             String  @id @default(cuid())
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String
  lat            Float
  lng            Float
  details        String
  streetName     String?
  buildingNumber String?
  floor          String?
  apartment      String?

  orders Order[] @relation("DeliveryAddressOrders")
}

model Restaurant {
  id             String           @id @default(cuid())
  ownerId        String
  owner          User             @relation("OwnerRestaurants", fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  slug           String           @unique
  logo           String?
  coverImage     String?
  description    String?
  primaryColor   String           @default("#2196F3")
  secondaryColor String           @default("#0A1A3C")
  status         RestaurantStatus @default(pending)
  commissionRate Float            @default(0.0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  branches         Branch[]
  coupons          Coupon[]
  reviews          Review[]
  staffMembers     RestaurantStaff[]
  paymentNumbers   PaymentNumber[]
  menuCategories   MenuCategory[]
  driverProfiles   DriverProfile[]
  customerMessages CustomerMessage[]
}

model RestaurantStaff {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffRole    StaffRole  @default(staff)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, userId])
}

model PaymentNumber {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  label        String
  type         PaymentType
  number       String
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Branch {
  id               String   @id @default(cuid())
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name             String   @default("الفرع الرئيسي")
  address          String
  lat              Float?
  lng              Float?
  phone            String
  openingHours     Json
  isActive            Boolean  @default(true)
  deliveryEnabled     Boolean  @default(true)
  deliveryRadiusKm    Float?   @default(10.0)
  baseDeliveryFee     Float?   @default(15.0)
  pricePerKm          Float?   @default(3.0)
  minOrderForDelivery Float?   @default(0.0)

  menuCategories  MenuCategory[]
  orders          Order[]
  branchMenuItems BranchMenuItem[]
  driverProfiles  DriverProfile[]
}

model MenuCategory {
  id           String      @id @default(cuid())
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  order        Int         @default(0)

  items MenuItem[]
}

model MenuItem {
  id            String       @id @default(cuid())
  categoryId    String
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  price         Float
  originalPrice Float?
  image         String?
  isAvailable   Boolean      @default(true)

  orderItems      OrderItem[]
  branchItems     BranchMenuItem[]
  optionGroups    ItemOptionGroup[]
  targetedCoupons Coupon[]          @relation("TargetMenuItemCoupons")
}

model ItemOptionGroup {
  id            String       @id @default(cuid())
  menuItemId    String
  menuItem      MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name          String
  selectionType String       @default("single")
  isRequired    Boolean      @default(false)
  minSelect     Int          @default(0)
  maxSelect     Int          @default(1)
  order         Int          @default(0)
  createdAt     DateTime     @default(now())

  options ItemOption[]
}

model ItemOption {
  id            String          @id @default(cuid())
  optionGroupId String
  optionGroup   ItemOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  name          String
  price         Float           @default(0.0)
  isDefault     Boolean         @default(false)
  order         Int             @default(0)
}

model BranchMenuItem {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  isAvailable   Boolean  @default(true)
  priceOverride Float?

  @@unique([branchId, menuItemId])
}

model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  discountType     DiscountType @default(percentage)
  discountValue    Float
  minOrderAmount   Float        @default(0.0)
  maxDiscount      Float?
  expiresAt        DateTime?
  isActive         Boolean      @default(true)
  restaurantId     String?
  restaurant       Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  targetScope      String       @default("order")
  targetMenuItemId String?
  targetMenuItem   MenuItem?    @relation("TargetMenuItemCoupons", fields: [targetMenuItemId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())

  orders Order[]
}

model Order {
  id                 String        @id @default(cuid())
  customerId         String
  customer           User          @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  branchId           String
  branch             Branch        @relation(fields: [branchId], references: [id])
  status             OrderStatus   @default(pending)
  totalPrice         Float
  discountAmount     Float         @default(0.0)
  deliveryFee        Float         @default(0.0)
  distanceKm         Float         @default(0.0)
  cancellationReason String?
  couponId           String?
  coupon             Coupon?       @relation(fields: [couponId], references: [id])
  deliveryAddressId  String
  deliveryAddress    Address       @relation("DeliveryAddressOrders", fields: [deliveryAddressId], references: [id])
  driverAssignmentId     String?
  posReferenceId         String?
  paymentMethod          PaymentMethod @default(cash_on_delivery)
  paymentProofImage      String?
  paymentStatus          PaymentStatus @default(not_required)

  riderId                String?
  riderUser              User?          @relation("RiderOrders", fields: [riderId], references: [id], onDelete: SetNull)
  riderProfileId         String?
  riderProfile           DriverProfile? @relation("RiderProfileOrders", fields: [riderProfileId], references: [id], onDelete: SetNull)
  riderDeliveryStatus    String?
  riderEarnings          Float?
  riderFeePercentage     Float?
  tipAmount              Float?
  podType                String?
  deliveryOtp            String?
  podOtpVerified         Boolean?       @default(false)
  podSignature           String?
  podPhoto               String?
  deliveredPaymentMethod String?
  deliveredLocationLat   Float?
  deliveredLocationLng   Float?
  podVerifiedAt          DateTime?
  assignedAt             DateTime?
  acceptedAt             DateTime?
  arrivedRestaurantAt    DateTime?
  pickedAt               DateTime?
  onTheWayAt             DateTime?
  arrivedCustomerAt      DateTime?
  deliveredAt            DateTime?

  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  items        OrderItem[]
  review       Review?
  chatMessages OrderChatMessage[]
}

model DriverProfile {
  id                  String      @id @default(cuid())
  userId              String      @unique
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  code                String?     @unique
  status              String?     @default("offline")
  supervisorId        String?
  restaurantId        String?
  restaurant          Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  branchId            String?
  branch              Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  currentShiftStart   DateTime?
  rating              Float?
  ratingCount         Int?        @default(0)
  lastSeen            DateTime?
  lastLocationLat    Float?
  lastLocationLng    Float?
  fcmToken            String?
  dailyBonus          Float?      @default(0)
  totalWithdrawals    Float?      @default(0)
  loans               Float?      @default(0)
  deductions          Float?      @default(0)
  totalCashHandedOver Float?      @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  shifts        Shift[]
  riderLocation RiderLocation?
  riderOrders   Order[]        @relation("RiderProfileOrders")
}

model Shift {
  id              String        @id @default(cuid())
  riderId         String
  rider           DriverProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int?
  autoClosed      Boolean       @default(false)
  date            String
  tenantId        String
  restaurantId    String
  branchId        String
  createdAt       DateTime      @default(now())
}

model RiderLocation {
  id           String        @id @default(cuid())
  riderId      String        @unique
  rider        DriverProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)
  lat          Float
  lng          Float
  updatedAt    DateTime      @updatedAt
  tenantId     String
  restaurantId String
  branchId     String
}

model OrderChatMessage {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel    String
  senderId   String
  senderName String
  senderRole String
  text       String
  timestamp  DateTime @default(now())
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id])
  quantity        Int
  price           Float
  notes           String?
  selectedOptions Json?
}

model Review {
  id             String     @id @default(cuid())
  orderId        String     @unique
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation("CustomerReviews", fields: [userId], references: [id], onDelete: Cascade)
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rating         Int
  foodRating     Int        @default(5)
  deliveryRating Int        @default(5)
  comment        String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model CustomerMessage {
  id           String    @id @default(cuid())
  customerId   String
  customer     User      @relation("CustomerMessages", fields: [customerId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subject      String?
  message      String
  type         String    @default("inquiry") // "inquiry" | "complaint"
  imageUrl     String?
  reply        String?
  repliedAt    DateTime?
  repliedById  String?
  status       String    @default("unread")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

